# Copy to .env (never commit it). `npm start` loads it automatically.

# Enables AI-written summaries. Without it the app falls back to a basic
# extractive summarizer that picks key sentences from the book.
ANTHROPIC_API_KEY=

# auto (default) | ai | extractive
#   auto        use Claude when a key is present, otherwise extractive
#   ai          require Claude (refuses to start without a key)
#   extractive  never call the API, even if a key is present
# SUMMARIZER=auto

# Model used for AI summaries. A smaller model is cheaper and faster.
# SUMMARY_MODEL=claude-opus-5-5

# Reasoning effort for AI summaries: low | medium | high | xhigh | max
# SUMMARY_EFFORT=medium

# PORT=3000
