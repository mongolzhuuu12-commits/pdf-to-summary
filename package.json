{
  "name": "pdf-to-summary",
  "version": "0.1.0",
  "description": "Upload a PDF book, get a 3-5 paragraph summary you can download or email.",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.9"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prestart": "npm run build",
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "npm run build && node --watch --env-file-if-exists=.env server.js",
    "test": "node --test"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "express": "^5.3.0",
    "pdfjs-dist": "^6.4.299"
  },
  "devDependencies": {
    "pdfkit": "^0.20.2"
  }
}
